{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Java: compile",
            "type": "process",
            "command": "javac",
            "args": [
                "-encoding", "UTF-8", "--release", "11",
                "-Xlint:all", "-Werror", "-d", "bin",
                "src/BankAccount.java", "src/InsufficientFundsException.java",
                "src/TransferService.java", "src/Main.java", "tests/BankingTests.java"
            ],
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$javac"]
        },
        {
            "label": "Java: test",
            "type": "process",
            "command": "java",
            "args": ["-Dfile.encoding=UTF-8", "-cp", "bin", "BankingTests"],
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Java: compile",
            "problemMatcher": []
        }
    ]
}
